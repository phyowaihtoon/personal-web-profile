NODE_ENV=development
PORT=4000

# Database target: onprem | supabase
# - onprem: uses DATABASE_URL (local or physical PostgreSQL)
# - supabase: uses SUPABASE_DATABASE_URL + SUPABASE_DIRECT_URL
DATABASE_TARGET=onprem
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_web_profile?schema=public"
# SUPABASE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# SUPABASE_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

#node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="b6fb0d0d47dd0ce7b7bb9a06219cade7435ce56278a5610f98baf7da08227a87"
JWT_REFRESH_SECRET="e10776e44278a52576acb5a75dbe4f2aaf55e865026a2a01fd8a54dbd24b1558"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
APP_LOCALE_DEFAULT="en"
UPLOAD_DIR="uploads"
UPLOAD_STORAGE="local"
SPACES_REGION="sgp1"
SPACES_ENDPOINT="sgp1.digitaloceanspaces.com"
SPACES_BUCKET=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
MAX_UPLOAD_SIZE_MB=5
COOKIE_SECURE=false
