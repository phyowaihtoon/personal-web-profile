NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_web_profile?schema=public"
JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
APP_LOCALE_DEFAULT="en"
UPLOAD_DIR="uploads"
UPLOAD_STORAGE="local"
SPACES_REGION="sgp1"
SPACES_ENDPOINT="sgp1.digitaloceanspaces.com"
SPACES_BUCKET=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
MAX_UPLOAD_SIZE_MB=5
COOKIE_SECURE=false