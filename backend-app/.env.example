NODE_ENV=development
PORT=4000

# Database target: onprem | supabase
# - onprem: uses DATABASE_URL (local or physical PostgreSQL)
# - supabase: uses SUPABASE_DATABASE_URL + SUPABASE_DIRECT_URL
DATABASE_TARGET=onprem
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/personal_web_profile?schema=public"
# SUPABASE_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# SUPABASE_DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

JWT_ACCESS_SECRET="replace-with-access-secret"
JWT_REFRESH_SECRET="replace-with-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
APP_LOCALE_DEFAULT="en"

# Upload storage: disabled | local | s3 | vercel-blob
# Leave unset or set to disabled if you are not ready to configure storage (safe on Vercel).
# - local: writes to UPLOAD_DIR (local/DO App Platform). Ignored on Vercel.
# - s3: DigitalOcean Spaces via complete SPACES_* vars
# - vercel-blob: Vercel Blob via BLOB_READ_WRITE_TOKEN (use a public Blob store)
UPLOAD_STORAGE="local"
UPLOAD_DIR="uploads"
# BLOB_READ_WRITE_TOKEN=""
SPACES_REGION="sgp1"
SPACES_ENDPOINT="sgp1.digitaloceanspaces.com"
SPACES_BUCKET=""
SPACES_CDN_BASE_URL=""
SPACES_ACCESS_KEY_ID=""
SPACES_SECRET_ACCESS_KEY=""
MAX_UPLOAD_SIZE_MB=5
COOKIE_SECURE=false
